# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
APP_NAME=WhatsApp Gateway
APP_VERSION=1.0.3

# WhatsApp Configuration
WA_SESSION_NAME=wa-gateway-session
WA_AUTH_DIR=auth_info_baileys
MAX_ACCOUNTS=10

# Security (wajib disertakan lewat header X-API-Key saat memanggil /api/*)
# API_KEY=4a73339cea59c42fc8bbdc938bbd051ac3f1ac835c1d7010
API_KEY=12345678
# Timezone
TZ=Asia/Jakarta

# Request & Upload
REQUEST_BODY_LIMIT=256kb
MAX_FILE_SIZE_BYTES=16777216

# Pengiriman Pesan
MESSAGE_TIMEOUT_MS=15000
LOGOUT_TIMEOUT_MS=15000
SEND_CONCURRENCY=1
MAX_QUEUE_SIZE=200

# Reconnect WhatsApp
RECONNECT_BASE_DELAY_MS=3000
RECONNECT_MAX_DELAY_MS=30000

# Dashboard & Logging
STATUS_POLL_INTERVAL_MS=5000
LOG_STATUS_CHECKS=false
LOG_LEVEL=info

# Webhook Pesan Masuk (kosongkan untuk menonaktifkan)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Broadcast & Pesan Terjadwal
MAX_BROADCAST_TARGETS=200
SCHEDULER_INTERVAL_MS=15000

PUBLIC_BASE_URL=
LOG_DIR=
DATA_DIR=
